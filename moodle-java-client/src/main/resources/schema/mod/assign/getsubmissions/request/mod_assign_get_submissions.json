{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "description": "Returns submissions for assignments.",
  "title": "GetSubmissionsRequest",
  "type": "object",
  "properties": {
    "wsfunction": {
      "default": "mod_assign_get_submissions",
      "type": "string"
    },
    "args": {
      "type": "object",
      "title": "GetSubmissionsArgs",
      "properties": {
        "assignmentids": {
          "description": "Assignment IDs",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "status": {
          "description": "Submission status",
          "type": "string"
        },
        "since": {
          "description": "Submitted since",
          "type": "integer"
        },
        "before": {
          "description": "Submitted before",
          "type": "integer"
        }
      },
      "required": [
        "assignmentids"
      ]
    }
  }
}
