{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "description": "Returns a list of forum posts for a discussion.",
  "title": "GetDiscussionPostsRequest",
  "type": "object",
  "properties": {
    "args": {
      "type": "object",
      "title": "GetDiscussionPostsArgs",
      "properties": {
        "sortdirection": {
          "description": "Sort direction: ASC or DESC",
          "type": "string",
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "includeinlineattachments": {
          "description": "Whether inline attachments should be included or not",
          "type": "integer"
        },
        "discussionid": {
          "description": "Discussion id",
          "type": "integer",
          "format": "int64"
        },
        "sortby": {
          "description": "Sort by this element: id, created or modified",
          "type": "string",
          "javaEnums": [
            {
              "name": "ID"
            },
            {
              "name": "CREATED"
            },
            {
              "name": "MODIFIED"
            }
          ],
          "enum": [
            "id",
            "created",
            "modified"
          ]
        }
      },
      "required": [
        "discussionid"
      ]
    },
    "wsfunction": {
      "default": "mod_forum_get_discussion_posts",
      "type": "string"
    }
  }
}
