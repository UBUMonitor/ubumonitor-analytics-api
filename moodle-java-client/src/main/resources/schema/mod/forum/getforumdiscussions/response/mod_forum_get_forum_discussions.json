{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetForumDiscussionsResponse",
  "type": "object",
  "properties": {
    "warnings": {
      "nullable": true,
      "description": "list of warnings",
      "title": "Warnings",
      "type": "array",
      "items": {
        "title": "Warning",
        "type": "object",
        "properties": {
          "itemid": {
            "nullable": true,
            "description": "item id",
            "type": "integer",
            "format": "int64"
          },
          "item": {
            "nullable": true,
            "description": "item",
            "type": "string"
          },
          "warningcode": {
            "description": "the warning code can be used by the client app to implement specific behaviour",
            "type": "string"
          },
          "message": {
            "description": "untranslated english message to explain the warning",
            "type": "string"
          }
        },
        "required": [
          "warningcode",
          "message"
        ]
      }
    },
    "discussions": {
      "type": "array",
      "items": {
        "title": "Discussion",
        "type": "object",
        "properties": {
          "timeend": {
            "description": "Time discussion ends",
            "type": "integer",
            "format": "int64"
          },
          "parent": {
            "description": "Parent id",
            "type": "integer",
            "format": "int64"
          },
          "pinned": {
            "description": "Is the discussion pinned",
            "type": "boolean"
          },
          "attachments": {
            "nullable": true,
            "description": "attachments",
            "title": "Attachments",
            "type": "array",
            "items": {
              "title": "File",
              "type": "object",
              "properties": {
                "isexternalfile": {
                  "nullable": true,
                  "description": "Whether is an external file",
                  "type": "boolean"
                },
                "filename": {
                  "nullable": true,
                  "description": "File name",
                  "type": "string"
                },
                "filepath": {
                  "nullable": true,
                  "description": "File path",
                  "type": "string"
                },
                "timemodified": {
                  "nullable": true,
                  "description": "Time modified",
                  "type": "integer",
                  "format": "int64"
                },
                "icon": {
                  "nullable": true,
                  "description": "Relative path to file type icon",
                  "type": "string"
                },
                "fileurl": {
                  "nullable": true,
                  "description": "Downloadable file url",
                  "type": "string"
                },
                "mimetype": {
                  "nullable": true,
                  "description": "File mime type",
                  "type": "string"
                },
                "filesize": {
                  "nullable": true,
                  "description": "File size",
                  "type": "integer"
                },
                "repositorytype": {
                  "nullable": true,
                  "description": "The repository type for external files",
                  "type": "string"
                }
              }
            }
          },
          "subject": {
            "description": "The post subject",
            "type": "string"
          },
          "totalscore": {
            "description": "The post message total score",
            "type": "integer"
          },
          "discussion": {
            "description": "Discussion id",
            "type": "integer",
            "format": "int64"
          },
          "userid": {
            "description": "User who started the discussion id",
            "type": "integer",
            "format": "int64"
          },
          "messagetrust": {
            "description": "Can we trust?",
            "type": "integer"
          },
          "usermodifiedpictureurl": {
            "format": "uri",
            "description": "Post modifier picture",
            "type": "string"
          },
          "usermodifiedfullname": {
            "description": "Post modifier full name",
            "type": "string"
          },
          "attachment": {
            "description": "Has attachments?",
            "type": "boolean"
          },
          "starred": {
            "description": "Is the discussion starred",
            "type": "boolean"
          },
          "modified": {
            "description": "Time modified",
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "description": "Post id",
            "type": "integer",
            "format": "int64"
          },
          "locked": {
            "description": "Is the discussion locked",
            "type": "boolean"
          },
          "mailed": {
            "description": "Mailed?",
            "type": "boolean"
          },
          "canreply": {
            "description": "Can the user reply to the discussion",
            "type": "boolean"
          },
          "userpictureurl": {
            "format": "uri",
            "description": "Post author picture",
            "type": "string"
          },
          "userfullname": {
            "description": "Post author full name",
            "type": "string"
          },
          "created": {
            "description": "Creation time",
            "type": "integer",
            "format": "int64"
          },
          "groupid": {
            "description": "Group id",
            "type": "integer",
            "format": "int64"
          },
          "messageformat": {
            "description": "message format (1 = HTML, 0 = MOODLE, 2 = PLAIN, or 4 = MARKDOWN)",
            "type": "integer",
            "javaEnums": [
              {
                "name": "MOODLE"
              },
              {
                "name": "HTML"
              },
              {
                "name": "PLAIN"
              },
              {
                "name": "MARKDOWN"
              }
            ],
            "enum": [
              0,
              1,
              2,
              4
            ]
          },
          "messageinlinefiles": {
            "nullable": true,
            "description": "post message inline files",
            "title": "Message Inline Files",
            "type": "array",
            "items": {
              "title": "File",
              "type": "object",
              "properties": {
                "isexternalfile": {
                  "nullable": true,
                  "description": "Whether is an external file",
                  "type": "boolean"
                },
                "filename": {
                  "nullable": true,
                  "description": "File name",
                  "type": "string"
                },
                "filepath": {
                  "nullable": true,
                  "description": "File path",
                  "type": "string"
                },
                "timemodified": {
                  "nullable": true,
                  "description": "Time modified",
                  "type": "integer",
                  "format": "int64"
                },
                "icon": {
                  "nullable": true,
                  "description": "Relative path to file type icon",
                  "type": "string"
                },
                "fileurl": {
                  "nullable": true,
                  "format": "uri",
                  "description": "Downloadable file url",
                  "type": "string"
                },
                "mimetype": {
                  "nullable": true,
                  "description": "File mime type",
                  "type": "string"
                },
                "filesize": {
                  "nullable": true,
                  "description": "File size",
                  "type": "integer"
                },
                "repositorytype": {
                  "nullable": true,
                  "description": "The repository type for external files",
                  "type": "string"
                }
              }
            }
          },
          "message": {
            "description": "The post message",
            "type": "string"
          },
          "numreplies": {
            "description": "The number of replies in the discussion",
            "type": "integer"
          },
          "canlock": {
            "description": "Can the user lock the discussion",
            "type": "boolean"
          },
          "timemodified": {
            "description": "Time modified",
            "type": "integer",
            "format": "int64"
          },
          "numunread": {
            "description": "The number of unread discussions",
            "type": "integer"
          },
          "canfavourite": {
            "description": "Can the user star the discussion",
            "type": "boolean"
          },
          "name": {
            "description": "Discussion name",
            "type": "string"
          },
          "mailnow": {
            "description": "Mail now?",
            "type": "boolean"
          },
          "usermodified": {
            "description": "The id of the user who last modified",
            "type": "integer",
            "format": "int64"
          },
          "timestart": {
            "description": "Time discussion can start",
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "name",
          "groupid",
          "timemodified",
          "usermodified",
          "timestart",
          "timeend",
          "discussion",
          "parent",
          "userid",
          "created",
          "modified",
          "mailed",
          "subject",
          "message",
          "messageformat",
          "messagetrust",
          "attachment",
          "totalscore",
          "mailnow",
          "userfullname",
          "usermodifiedfullname",
          "userpictureurl",
          "usermodifiedpictureurl",
          "numreplies",
          "numunread",
          "pinned",
          "locked",
          "starred",
          "canreply",
          "canlock",
          "canfavourite"
        ]
      }
    }
  },
  "required": [
    "discussions"
  ]
}
