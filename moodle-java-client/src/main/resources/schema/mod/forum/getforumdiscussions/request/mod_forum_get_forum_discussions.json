{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "description": "Returns a list of forum instances in a provided set of courses, if no courses are provided then all the forum instances the user has access to will be returned.\n",
  "title": "GetForumDiscussionsRequest",
  "type": "object",
  "properties": {
    "args": {
      "type": "object",
      "title": "GetForumDiscussionsArgs",
      "properties": {
        "perpage": {
          "description": "items per page",
          "type": "integer"
        },
        "groupid": {
          "description": "Group id",
          "type": "integer",
          "format": "int64"
        },
        "sortorder": {
          "description": "sort by this element: numreplies, , created or timemodified",
          "type": "integer",
          "javaEnums": [
            {
              "name": "LASTPOST_DESC"
            },
            {
              "name": "LASTPOST_ASC"
            },
            {
              "name": "CREATED_DESC"
            },
            {
              "name": "CREATED_ASC"
            },
            {
              "name": "REPLIES_DESC"
            },
            {
              "name": "REPLIES_ASC"
            }
          ],
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "page": {
          "description": "current page",
          "type": "integer"
        },
        "forumid": {
          "description": "Forum Id",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "forumid"
      ]
    },
    "wsfunction": {
      "default": "mod_forum_get_forum_discussions",
      "type": "string"
    }
  }
}
