{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetForumsByCoursesRequest",
  "description": "Returns a list of forum instances in a provided set of courses, if no courses are provided then all the forum instances the user has access to will be returned.\n",
  "type": "object",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "properties": {
    "wsfunction": {
      "type": "string",
      "default": "mod_forum_get_forums_by_courses"
    },
    "args": {
      "type": "object",
      "title": "GetForumsByCoursesArgs",
      "properties": {
        "courseids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Course Ids"
        }
      },
      "required": [
        "courseids"
      ]
    }
  }
}
