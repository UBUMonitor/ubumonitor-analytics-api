      },
      "maxattachments": {
        "description": "Maximum number of attachments",
        "type": "integer"
      },
      "assessed": {
        "description": "Aggregate type",
        "type": "integer"
      },
      "rsstype": {
        "description": "RSS feed for this activity",
        "type": "integer"
      },
      "introfiles": {
        "description": "Files in the introduction text",
