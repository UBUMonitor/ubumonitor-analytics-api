      "maxbytes": {
        "description": "Maximum attachment size",
        "type": "integer"
      },
      "grade_forum_notify": {
        "description": "Whether to send notifications to students upon grading by default",
        "type": "boolean"
      },
      "cutoffdate": {
        "nullable": true,
