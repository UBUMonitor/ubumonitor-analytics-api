          "type": "object",
          "title": "Intro File",
          "properties": {
            "isexternalfile": {
              "nullable": true,
              "description": "Whether is an external file",
              "type": "boolean"
            },
            "filename": {
              "nullable": true,
              "description": "File name",
              "type": "string"
            },
            "filepath": {
              "nullable": true,
              "description": "File path",
              "type": "string"
            },
            "timemodified": {
              "nullable": true,
              "description": "Time modified",
              "type": "integer"
            },
            "icon": {
              "nullable": true,
              "description": "The relative path to the relevant file type icon based on the file's mime type",
              "type": "string"
            },
            "fileurl": {
              "nullable": true,
              "format": "uri",
              "description": "Downloadable file url",
              "type": "string"
            },
            "mimetype": {
              "nullable": true,
              "description": "File mime type",
              "type": "string"
            },
            "filesize": {
              "nullable": true,
