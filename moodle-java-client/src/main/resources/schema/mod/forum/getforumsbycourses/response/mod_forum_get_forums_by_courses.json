      "course",
      "type",
      "name",
      "intro",
      "introformat",
      "assessed",
      "assesstimestart",
      "assesstimefinish",
      "scale",
      "grade_forum",
      "grade_forum_notify",
      "maxbytes",
      "maxattachments",
      "forcesubscribe",
      "trackingtype",
      "rsstype",
      "rssarticles",
      "timemodified",
      "warnafter",
      "blockafter",
      "blockperiod",
      "completiondiscussions",
      "completionreplies",
