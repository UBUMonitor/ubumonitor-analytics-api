{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoginTokenRequest",
  "type": "object",
  "properties": {
    "password": {
      "format": "password",
      "type": "string"
    },
    "baseurl": {
      "format": "uri",
      "type": "string"
    },
    "service": {
      "default": "moodle_mobile_app",
      "type": "string"
    },
    "username": {
      "type": "string"
    }
  },
  "required": [
    "baseurl",
    "username",
    "password"
  ]
}
