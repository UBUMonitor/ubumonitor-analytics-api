{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetGradeItemsResponse",
  "type": "object",
  "properties": {
    "usergrades": {
      "nullable": true,
      "description": "list of user grades",
      "type": "array",
      "items": {
        "type": "object",
        "title": "UserGrade",
        "properties": {
          "courseidnumber": {
            "nullable": true,
            "description": "course idnumber",
            "type": "string"
          },
          "userfullname": {
            "nullable": true,
            "description": "user fullname",
            "type": "string"
          },
          "gradeitems": {
            "nullable": true,
            "description": "Grade items",
            "type": "array",
            "items": {
              "type": "object",
              "title": "GradeItem",
              "properties": {
                "scaleid": {
                  "nullable": true,
                  "description": "Scale id",
                  "type": "integer",
                  "format": "int64"
                },
                "gradeislocked": {
                  "nullable": true,
                  "description": "Grade is locked?",
                  "type": "boolean"
                },
                "itemnumber": {
                  "nullable": true,
                  "description": "Grade item item number",
                  "type": "integer",
                  "format": "int64"
                },
                "idnumber": {
                  "nullable": true,
                  "description": "Grade item idnumber",
                  "type": "string"
                },
                "percentageformatted": {
                  "nullable": true,
                  "description": "Percentage",
                  "type": "string"
                },
                "outcomeid": {
                  "nullable": true,
                  "description": "Outcome id",
                  "type": "integer",
                  "format": "int64"
                },
                "gradeishidden": {
                  "nullable": true,
                  "description": "Grade is hidden?",
                  "type": "boolean"
                },
                "feedbackformat": {
                  "nullable": true,
                  "description": "feedback format (1 = HTML, 0 = MOODLE, 2 = PLAIN, or 4 = MARKDOWN)",
                  "type": "integer",
                  "javaEnums": [
                    {
                      "name": "MOODLE"
                    },
                    {
                      "name": "HTML"
                    },
                    {
                      "name": "PLAIN"
                    },
                    {
                      "name": "MARKDOWN"
                    }
                  ],
                  "enum": [
                    0,
                    1,
                    2,
                    4
                  ]
                },
                "grademin": {
                  "nullable": true,
                  "description": "Grade min",
                  "type": "number"
                },
                "feedback": {
                  "nullable": true,
                  "description": "Grade feedback",
                  "type": "string"
                },
                "iteminstance": {
                  "nullable": true,
                  "description": "Grade item instance",
                  "type": "integer",
                  "format": "int64"
                },
                "rank": {
                  "nullable": true,
                  "description": "Rank in the course",
                  "type": "integer"
                },
                "id": {
                  "nullable": true,
                  "description": "Grade item id",
                  "type": "integer",
                  "format": "int64"
                },
                "locked": {
                  "nullable": true,
                  "description": "Grade item for user locked?",
                  "type": "boolean"
                },
                "categoryid": {
                  "nullable": true,
                  "description": "Grade item category id",
                  "type": "integer",
                  "format": "int64"
                },
                "numusers": {
                  "nullable": true,
                  "description": "Num users in course",
                  "type": "integer"
                },
                "weightformatted": {
                  "nullable": true,
                  "description": "Weight",
                  "type": "string"
                },
                "parentcategoryid": {
                  "nullable": true,
                  "description": "Parent category id",
                  "type": "integer",
                  "format": "int64"
                },
                "itemname": {
                  "nullable": true,
                  "description": "Grade item name",
                  "type": "string"
                },
                "gradedatesubmitted": {
                  "nullable": true,
                  "description": "Grade submit date",
                  "type": "integer",
                  "format": "int64"
                },
                "graderaw": {
                  "nullable": true,
                  "description": "Grade raw",
                  "type": "number"
                },
                "gradeisoverridden": {
                  "nullable": true,
                  "description": "Grade overridden?",
                  "type": "boolean"
                },
                "rangeformatted": {
                  "nullable": true,
                  "description": "Range formatted",
                  "type": "string"
                },
                "lettergradeformatted": {
                  "nullable": true,
                  "description": "Letter grade",
                  "type": "string"
                },
                "cmid": {
                  "nullable": true,
                  "description": "Course module id (if type mod)",
                  "type": "integer",
                  "format": "int64"
                },
                "gradeformatted": {
                  "nullable": true,
                  "description": "The grade formatted",
                  "type": "string"
                },
                "gradedategraded": {
                  "nullable": true,
                  "description": "Grade graded date",
                  "type": "integer",
                  "format": "int64"
                },
                "itemtype": {
                  "nullable": true,
                  "description": "Grade item type",
                  "type": "string"
                },
                "itemmodule": {
                  "nullable": true,
                  "description": "Grade item module",
                  "type": "string"
                },
                "averageformatted": {
                  "nullable": true,
                  "description": "Grade average",
                  "type": "string"
                },
                "weightraw": {
                  "nullable": true,
                  "description": "Weight raw",
                  "type": "number"
                },
                "gradehiddenbydate": {
                  "nullable": true,
                  "description": "Grade hidden by date?",
                  "type": "boolean"
                },
                "gradeneedsupdate": {
                  "nullable": true,
                  "description": "Grade needs update?",
                  "type": "boolean"
                },
                "grademax": {
                  "nullable": true,
                  "description": "Grade max",
                  "type": "number"
                },
                "status": {
                  "nullable": true,
                  "description": "Status",
                  "type": "string"
                }
              }
            }
          },
          "useridnumber": {
            "nullable": true,
            "description": "user idnumber",
            "type": "string"
          },
          "courseid": {
            "nullable": true,
            "description": "course id",
            "type": "integer",
            "format": "int64"
          },
          "userid": {
            "nullable": true,
            "description": "user id",
            "type": "integer",
            "format": "int64"
          },
          "maxdepth": {
            "nullable": true,
            "description": "table max depth (needed for printing it)",
            "type": "integer"
          }
        }
      }
    },
    "warnings": {
      "nullable": true,
      "description": "list of warnings",
      "type": "array",
      "items": {
        "type": "object",
        "title": "Warning",
        "properties": {
          "itemid": {
            "nullable": true,
            "description": "item id",
            "type": "integer",
            "format": "int64"
          },
          "item": {
            "nullable": true,
            "description": "item",
            "type": "string"
          },
          "warningcode": {
            "nullable": true,
            "description": "the warning code can be used by the client app to implement specific behaviour",
            "type": "string"
          },
          "message": {
            "nullable": true,
            "description": "untranslated english message to explain the warning",
            "type": "string"
          }
        }
      }
    }
  }
}
