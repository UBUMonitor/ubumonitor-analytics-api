{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "description": "Returns the complete list of grade items for users in a course",
  "title": "GetGradeItemsRequest",
  "type": "object",
  "properties": {
    "args": {
      "type": "object",
      "title": "GetGradeItemsArgs",
      "properties": {
        "groupid": {
          "nullable": true,
          "description": "Get users from this group only",
          "type": "integer"
        },
        "courseid": {
          "description": "Course Id",
          "type": "integer"
        },
        "userid": {
          "nullable": true,
          "description": "Return grades only for this user",
          "type": "integer"
        }
      },
      "required": [
        "userid"
      ]
    },
    "wsfunction": {
      "default": "gradereport_user_get_grade_items",
      "type": "string"
    }
  }
}
