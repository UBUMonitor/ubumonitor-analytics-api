{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "description": "Get the user/s report grades table for a course",
  "title": "GetGradesTableRequest",
  "type": "object",
  "properties": {
    "args": {
      "type": "object",
      "title": "GetGradesTableArgs",
      "properties": {
        "groupid": {
          "nullable": true,
          "description": "Get users from this group only",
          "type": "integer"
        },
        "courseid": {
          "description": "Course Id",
          "type": "integer"
        },
        "userid": {
          "nullable": true,
          "description": "Return grades only for this user",
          "type": "integer"
        }
      },
      "required": [
        "userid"
      ]
    },
    "wsfunction": {
      "default": "gradereport_user_get_grades_table",
      "type": "string"
    }
  }
}
