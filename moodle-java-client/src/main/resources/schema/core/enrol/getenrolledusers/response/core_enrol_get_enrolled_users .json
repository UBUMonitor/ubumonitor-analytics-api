{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "title": "GetEnrolledUsersResponse",
    "type": "object",
    "properties": {
      "country": {
        "nullable": true,
        "description": "Home country code of the user, such as AU or CZ",
        "type": "string"
      },
      "firstname": {
        "nullable": true,
        "description": "The first name(s) of the user",
        "type": "string"
      },
      "city": {
        "nullable": true,
        "description": "Home city of the user",
        "type": "string"
      },
      "idnumber": {
        "nullable": true,
        "description": "An arbitrary ID code number perhaps from the institution",
        "type": "string"
      },
      "roles": {
        "nullable": true,
        "description": "User roles",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "roleid": {
              "description": "Role id",
              "type": "integer",
              "format": "int64"
            },
            "name": {
              "description": "Role name",
              "type": "string"
            },
            "sortorder": {
              "description": "Role sortorder",
              "type": "integer"
            },
            "shortname": {
              "description": "Role shortname",
              "type": "string"
            }
          },
          "required": [
            "roleid",
            "name",
            "shortname",
            "sortorder"
          ]
        }
      },
      "phone2": {
        "nullable": true,
        "description": "Phone 2",
        "type": "string"
      },
      "description": {
        "nullable": true,
        "description": "User profile description",
        "type": "string"
      },
      "firstaccess": {
        "nullable": true,
        "description": "First access to the site (0 if never)",
        "type": "integer",
        "format": "int64"
      },
      "customfields": {
        "nullable": true,
        "description": "User custom fields (also known as user profile fields)",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "description": "The name of the custom field",
              "type": "string"
            },
            "type": {
              "description": "The type of the custom field - text field, checkbox...",
              "type": "string"
            },
            "value": {
              "description": "The value of the custom field",
              "type": "string"
            },
            "shortname": {
              "description": "The shortname of the custom field - to build the field class in code",
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "name",
            "shortname"
          ]
        }
      },
      "phone1": {
        "nullable": true,
        "description": "Phone 1",
        "type": "string"
      },
      "profileimageurlsmall": {
        "nullable": true,
        "format": "uri",
        "description": "User image profile URL - small version",
        "type": "string"
      },
      "institution": {
        "nullable": true,
        "description": "Institution",
        "type": "string"
      },
      "enrolledcourses": {
        "nullable": true,
        "description": "Courses where the user is enrolled",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "description": "Id of the course",
              "type": "integer",
              "format": "int64"
            },
            "fullname": {
              "description": "Fullname of the course",
              "type": "string"
            },
            "shortname": {
              "description": "Shortname of the course",
              "type": "string"
            }
          },
          "required": [
            "id",
            "fullname",
            "shortname"
          ]
        }
      },
      "id": {
        "description": "ID of the user",
        "type": "integer",
        "format": "int64"
      },
      "department": {
        "nullable": true,
        "description": "Department",
        "type": "string"
      },
      "email": {
        "nullable": true,
        "description": "An email address - allow email as root@localhost",
        "type": "string"
      },
      "preferences": {
        "nullable": true,
        "description": "User preferences",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "description": "The name of the preference",
              "type": "string"
            },
            "value": {
              "description": "The value of the preference",
              "type": "string"
            }
          },
          "required": [
            "name",
            "value"
          ]
        }
      },
      "address": {
        "nullable": true,
        "description": "Postal address",
        "type": "string"
      },
      "groups": {
        "nullable": true,
        "description": "User groups",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "description": "Group name",
              "type": "string"
            },
            "description": {
              "description": "Group description",
              "type": "string"
            },
            "descriptionformat": {
              "description": "Description format (1 = HTML, 0 = MOODLE, 2 = PLAIN, or 4 = MARKDOWN)",
              "type": "integer",
              "javaEnums": [
                {
                  "name": "MOODLE"
                },
                {
                  "name": "HTML"
                },
                {
                  "name": "PLAIN"
                },
                {
                  "name": "MARKDOWN"
                }
              ],
              "enum": [
                0,
                1,
                2,
                4
              ]
            },
            "id": {
              "description": "Group id",
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "id",
            "name",
            "description",
            "descriptionformat"
          ]
        }
      },
      "lastcourseaccess": {
        "nullable": true,
        "description": "Last access to the course (0 if never)",
        "type": "integer",
        "format": "int64"
      },
      "lastname": {
        "nullable": true,
        "description": "The family name of the user",
        "type": "string"
      },
      "lastaccess": {
        "nullable": true,
        "description": "Last access to the site (0 if never)",
        "type": "integer",
        "format": "int64"
      },
      "descriptionformat": {
        "nullable": true,
        "description": "Description format (1 = HTML, 0 = MOODLE, 2 = PLAIN, or 4 = MARKDOWN)",
        "type": "integer",
        "javaEnums": [
          {
            "name": "MOODLE"
          },
          {
            "name": "HTML"
          },
          {
            "name": "PLAIN"
          },
          {
            "name": "MARKDOWN"
          }
        ],
        "enum": [
          0,
          1,
          2,
          4
        ]
      },
      "fullname": {
        "description": "The fullname of the user",
        "type": "string"
      },
      "profileimageurl": {
        "nullable": true,
        "format": "uri",
        "description": "User image profile URL - big version",
        "type": "string"
      },
      "interests": {
        "nullable": true,
        "description": "User interests (separated by commas)",
        "type": "string"
      },
      "username": {
        "nullable": true,
        "description": "Username policy is defined in Moodle security config",
        "type": "string"
      }
    },
    "required": [
      "id",
      "fullname"
    ]
  }
}
