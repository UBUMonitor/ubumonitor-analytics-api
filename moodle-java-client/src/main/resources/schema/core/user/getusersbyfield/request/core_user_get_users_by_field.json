{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "description": "Retrieve users' information for a specified unique field - If you want to do a user search, use core_user_get_users() or core_user_search_identity().\n",
  "title": "GetUsersByFieldRequest",
  "type": "object",
  "properties": {
    "args": {
      "type": "object",
      "title": "GetUsersByFieldArgs",
      "properties": {
        "field": {
          "description": "the search field can be 'id' or 'idnumber' or 'username' or 'email'",
          "type": "string",
          "javaEnums": [
            {
              "name": "ID"
            },
            {
              "name": "ID_NUMBER"
            },
            {
              "name": "USERNAME"
            },
            {
              "name": "EMAIL"
            }
          ],
          "enum": [
            "id",
            "idnumber",
            "username",
            "email"
          ]
        },
        "values": {
          "description": "the value to match",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "field",
        "values"
      ]
    },
    "wsfunction": {
      "default": "core_user_get_users_by_field",
      "type": "string"
    }
  }
}
