    "properties": {
      "country": {
        "nullable": true,
        "description": "Home country code of the user, such as AU or CZ",
        "type": "string"
      },
      "firstname": {
        "nullable": true,
        "description": "The first name(s) of the user",
        "type": "string"
      },
      "auth": {
        "nullable": true,
        "description": "Auth plugins include manual, ldap, etc",
        "type": "string"
      },
      "city": {
        "nullable": true,
        "description": "Home city of the user",
        "type": "string"
      },
      "timezone": {
        "nullable": true,
        "description": "Timezone code such as Australia/Perth, or 99 for default",
        "type": "string"
      },
      "idnumber": {
        "nullable": true,
        "description": "An arbitrary ID code number perhaps from the institution",
        "type": "string"
      },
      "phone2": {
        "nullable": true,
        "description": "Phone 2",
        "type": "string"
      },
      "description": {
        "nullable": true,
        "description": "User profile description",
        "type": "string"
      },
      "firstaccess": {
        "nullable": true,
        "description": "First access to the site (0 if never)",
        "type": "integer"
      },
      "confirmed": {
        "nullable": true,
        "description": "Active user: 1 if confirmed, 0 otherwise",
        "type": "boolean"
      },
      "customfields": {
        "nullable": true,
        "description": "User custom fields (also known as user profile fields)",
        "title": "Custom Fields",
        "type": "array",
        "items": {
          "title": "Custom Field",
          "type": "object",
          "properties": {
            "name": {
              "description": "The name of the custom field",
              "type": "string"
            },
            "type": {
              "description": "The type of the custom field - text field, checkbox...",
              "type": "string"
            },
            "value": {
              "description": "The value of the custom field (as stored in the database)",
              "type": "string"
            },
            "displayvalue": {
              "nullable": true,
              "description": "The value of the custom field for display",
              "type": "string"
            },
            "shortname": {
              "description": "The shortname of the custom field - to be able to build the field class in the code",
              "type": "string"
            }
          },
          "required": [
            "type",
            "value",
            "name",
            "shortname"
          ]
        }
      },
      "phone1": {
        "nullable": true,
        "description": "Phone 1",
        "type": "string"
      },
      "trackforums": {
        "nullable": true,
        "description": "Whether the user is tracking forums",
        "type": "integer"
      },
      "profileimageurlsmall": {
        "description": "User image profile URL - small version",
        "type": "string"
      },
      "institution": {
        "nullable": true,
        "description": "Institution",
        "type": "string"
      },
      "theme": {
        "nullable": true,
        "description": "Theme name such as 'standard', must exist on server",
