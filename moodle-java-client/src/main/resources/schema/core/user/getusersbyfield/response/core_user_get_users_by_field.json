      "lastname": {
        "nullable": true,
        "description": "The family name of the user",
        "type": "string"
      },
      "lastaccess": {
        "nullable": true,
        "description": "Last access to the site (0 if never)",
        "type": "integer"
      },
      "calendartype": {
        "nullable": true,
        "description": "Calendar type such as 'gregorian', must exist on server",
        "type": "string"
      },
      "descriptionformat": {
        "nullable": true,
        "description": "int format (1 = HTML, 0 = MOODLE, 2 = PLAIN, or 4 = MARKDOWN)",
        "type": "integer",
        "javaEnums": [
          {
            "name": "MOODLE"
          },
          {
            "name": "HTML"
          },
          {
            "name": "PLAIN"
          },
          {
            "name": "MARKDOWN"
          }
        ],
        "enum": [
          0,
          1,
          2,
          4
        ]
      },
      "fullname": {
        "description": "The fullname of the user",
        "type": "string"
      },
      "profileimageurl": {
        "description": "User image profile URL - big version",
        "type": "string"
      },
      "interests": {
        "nullable": true,
        "description": "User interests (separated by commas)",
        "type": "string"
      },
      "username": {
        "nullable": true,
        "description": "The username",
        "type": "string"
      }
