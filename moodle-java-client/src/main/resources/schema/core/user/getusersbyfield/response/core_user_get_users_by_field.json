            "name": "MOODLE"
          },
          {
            "name": "HTML"
          },
          {
            "name": "PLAIN"
          },
          {
            "name": "MARKDOWN"
          }
        ],
        "enum": [
          0,
          1,
          2,
          4
        ]
      },
      "preferences": {
        "nullable": true,
        "description": "User preferences",
        "title": "Preferences",
        "type": "array",
        "items": {
          "title": "Preference",
          "type": "object",
          "properties": {
            "name": {
              "description": "The name of the preference",
