{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetActivitiesCompletionStatusResponse",
  "type": "object",
  "properties": {
    "warnings": {
      "nullable": true,
      "description": "list of warnings",
      "type": "array",
      "items": {
        "type": "object",
        "title": "Warning",
        "properties": {
          "itemid": {
            "nullable": true,
            "description": "item id",
            "type": "integer",
            "format": "int64"
          },
          "item": {
            "nullable": true,
            "description": "item",
            "type": "string"
          },
          "warningcode": {
            "description": "warning code",
            "type": "string"
          },
          "message": {
            "description": "untranslated english message",
            "type": "string"
          }
        },
        "required": [
          "warningcode",
          "message"
        ]
      }
    },
    "statuses": {
      "description": "List of activities status",
      "type": "array",
      "items": {
        "type": "object",
        "title": "ActivityCompletionStatus",
        "properties": {
          "instance": {
            "description": "instance ID",
            "type": "integer",
            "format": "int64"
          },
          "istrackeduser": {
            "description": "Whether completion is tracked for this user",
            "type": "boolean"
          },
          "valueused": {
            "description": "Whether the completion status affects availability of another activity",
            "type": "boolean"
          },
          "modname": {
            "description": "activity module name",
            "type": "string"
          },
          "timecompleted": {
            "description": "timestamp for completed activity",
            "type": "integer",
            "format": "int64"
          },
          "cmid": {
            "description": "course module ID",
            "type": "integer",
            "format": "int64"
          },
          "isautomatic": {
            "description": "Whether completion is tracked automatically",
            "type": "boolean"
          },
          "tracking": {
            "description": "type of tracking: 0 none, 1 manual, 2 automatic",
            "type": "integer",
            "javaEnums": [
              {
                "name": "NONE"
              },
              {
                "name": "MANUAL"
              },
              {
                "name": "AUTOMATIC"
              }
            ],
            "enum": [
              0,
              1,
              2
            ]
          },
          "hascompletion": {
            "description": "Whether this activity has completion enabled",
            "type": "boolean"
          },
          "isoverallcomplete": {
            "description": "Whether overall completion should be marked as complete",
            "type": "boolean"
          },
          "details": {
            "default": [],
            "description": "Completion status details",
            "type": "array",
            "items": {
              "type": "object",
              "title": "CompletionDetail",
              "properties": {
                "rulename": {
                  "description": "Rule name",
                  "type": "string"
                },
                "rulevalue": {
                  "type": "object",
                  "title": "CompletionRuleValue",
                  "properties": {
                    "description": {
                      "description": "Completion description",
                      "type": "string"
                    },
                    "status": {
                      "description": "Completion status",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "status",
                    "description"
                  ]
                }
              },
              "required": [
                "rulename",
                "rulevalue"
              ]
            }
          },
          "state": {
            "description": "Completion state: 0 incomplete, 1 complete, 2 pass, 3 fail",
            "type": "integer",
            "javaEnums": [
              {
                "name": "INCOMPLETE"
              },
              {
                "name": "COMPLETE"
              },
              {
                "name": "PASS"
              },
              {
                "name": "FAIL"
              }
            ],
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "overrideby": {
            "nullable": true,
            "description": "User id who overrode the status, or null",
            "type": "integer",
            "format": "int64"
          },
          "uservisible": {
            "description": "Whether this activity is visible to the user",
            "type": "boolean"
          }
        },
        "required": [
          "cmid",
          "modname",
          "instance",
          "state",
          "timecompleted",
          "tracking",
          "valueused",
          "hascompletion",
          "isautomatic",
          "istrackeduser",
          "uservisible",
          "details",
          "isoverallcomplete"
        ]
      }
    }
  },
  "required": [
    "statuses"
  ]
}
