{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetCalendarEventsRequest",
  "description": "Get calendar events",
  "type": "object",
  "extends": {
    "$ref": "../../../../common/moodle_webservice_request.json"
  },
  "properties": {
    "wsfunction": {
      "type": "string",
      "default": "core_calendar_get_calendar_events"
    },
    "args": {
      "type": "object",
      "title": "GetCalendarEventsArgs",
      "properties": {
        "events": {
          "type": "object",
          "title": "EventDetails",
          "description": "Event details",
          "properties": {
            "eventids": {
              "type": "array",
              "description": "List of event IDs",
              "items": {
                "type": "integer"
              }
            },
            "courseids": {
              "type": "array",
              "description": "List of course IDs",
              "items": {
                "type": "integer"
              }
            },
            "groupids": {
              "type": "array",
              "description": "List of group IDs",
              "items": {
                "type": "integer"
              }
            },
            "categoryids": {
              "type": "array",
              "description": "List of category IDs",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "options": {
          "type": "object",
          "title": "EventOptions",
          "description": "Event options",
          "properties": {
            "userevents": {
              "type": "integer",
              "description": "Set to true to return current user's user events"
            },
            "siteevents": {
              "type": "integer",
              "description": "Set to true to return site events"
            },
            "timestart": {
              "type": "integer",
              "description": "Time from which events should be returned"
            },
            "timeend": {
              "type": "integer",
              "description": "Time to which the events should be returned. We treat 0 and null as no end"
            },
            "ignorehidden": {
              "type": "integer",
              "description": "Ignore hidden events or not"
            }
          }
        }
      },
      "required": [
        "courseid",
        "userid"
      ]
    }
  }
}
