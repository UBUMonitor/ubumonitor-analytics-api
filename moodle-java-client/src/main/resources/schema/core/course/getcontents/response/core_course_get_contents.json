{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetCourseContentsResponse",
  "type": "array",
  "items": {
    "type": "object",
    "title": "GetCourseContentsResponse",
    "required": [
      "id",
      "name",
      "summary",
      "summaryformat",
      "modules"
    ],
    "properties": {
      "summary": {
        "description": "Section description",
        "type": "string"
      },
      "itemid": {
        "nullable": true,
        "description": "Optional item id the delegate component can use to identify its instance",
        "type": "integer"
      },
      "component": {
        "nullable": true,
        "description": "The delegate component of this section if any",
        "type": "string"
      },
      "visible": {
        "nullable": true,
        "description": "Is the section visible",
        "type": "boolean"
      },
      "name": {
        "description": "Section name",
        "type": "string"
      },
      "availabilityinfo": {
        "nullable": true,
        "description": "Availability information.",
        "type": "string"
      },
      "summaryformat": {
        "description": "Summary format (1 = HTML, 0 = MOODLE, 2 = PLAIN, 4 = MARKDOWN)",
        "type": "integer",
        "javaEnums": [
          {
            "name": "MOODLE"
          },
          {
            "name": "HTML"
          },
          {
            "name": "PLAIN"
          },
          {
            "name": "MARKDOWN"
          }
        ],
        "enum": [
          0,
          1,
          2,
          4
        ]
      },
      "section": {
        "nullable": true,
        "description": "Section number inside the course",
        "type": "integer"
      },
      "hiddenbynumsections": {
        "nullable": true,
        "description": "Whether this section is hidden in the course format",
        "type": "boolean"
      },
      "id": {
        "description": "Section ID",
        "type": "integer"
      },
      "uservisible": {
        "nullable": true,
        "description": "Is the section visible for the user?",
        "type": "boolean"
      },
      "modules": {
        "description": "List of modules in the section",
        "type": "array",
        "items": {
          "type": "object",
          "title": "Module",
          "required": [
            "id",
            "name",
            "modicon",
            "modname",
            "purpose",
            "modplural",
            "indent",
            "completiondata"
          ],
          "properties": {
            "instance": {
              "nullable": true,
              "description": "Instance ID",
              "type": "integer"
            },
            "purpose": {
              "description": "The module purpose",
              "type": "string"
            },
            "indent": {
              "description": "Number of indentation in the site",
              "type": "integer"
            },
            "description": {
              "nullable": true,
              "description": "Activity description",
              "type": "string"
            },
            "contextid": {
              "nullable": true,
              "description": "Activity context ID",
              "type": "integer"
            },
            "availability": {
              "nullable": true,
              "description": "Module availability settings",
              "type": "string"
            },
            "branded": {
              "nullable": true,
              "description": "Whether the module is branded or not",
              "type": "boolean"
            },
            "modicon": {
              "format": "uri",
              "description": "Activity icon URL",
              "type": "string"
            },
            "completiondata": {
              "description": "Detailed completion information for the module",
              "type": "object",
              "title": "CompletionData",
              "required": [
                "state",
                "timecompleted",
                "overrideby",
                "valueused",
                "hascompletion",
                "isautomatic",
                "istrackeduser",
                "uservisible",
                "details"
              ],
              "properties": {
                "hascompletion": {
                  "description": "Whether this activity module has completion enabled",
                  "type": "boolean"
                },
                "istrackeduser": {
                  "description": "Whether completion is being tracked for this user",
                  "type": "boolean"
                },
                "valueused": {
                  "description": "True if module is used in a condition",
                  "type": "boolean"
                },
                "timecompleted": {
                  "description": "Course completion timestamp",
                  "type": "integer"
                },
                "isoverallcomplete": {
                  "nullable": true,
                  "description": "Whether the overall completion state should be marked complete",
                  "type": "boolean"
                },
                "details": {
                  "description": "Array of completion details containing description and status",
                  "type": "array",
                  "title": "CompletionDetail",
                  "items": {
                    "type": "object",
                    "required": [
                      "rulename",
                      "rulevalue"
                    ],
                    "properties": {
                      "rulename": {
                        "description": "Rule name",
                        "type": "string"
                      },
                      "rulevalue": {
                        "type": "object",
                        "title": "CompletionRuleValue",
                        "required": [
                          "status",
                          "description"
                        ],
                        "properties": {
                          "description": {
                            "description": "Rule description",
                            "type": "string"
                          },
                          "status": {
                            "description": "Rule status",
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                },
                "state": {
                  "description": "Overall completion state of this module",
                  "type": "integer"
                },
                "overrideby": {
                  "description": "User ID that has overridden the completion state",
                  "type": "integer"
                },
                "isautomatic": {
                  "description": "Whether completion is tracked automatically",
                  "type": "boolean"
                },
                "uservisible": {
                  "description": "Whether this activity is visible to the user",
                  "type": "boolean"
                }
              }
            },
            "id": {
              "description": "Activity ID",
              "type": "integer"
            },
            "customdata": {
              "nullable": true,
              "description": "Custom data (JSON encoded)",
              "type": "string"
            },
            "uservisible": {
              "nullable": true,
              "description": "Is the module visible for the user?",
              "type": "boolean"
            },
            "afterlink": {
              "nullable": true,
              "description": "After link info to be displayed",
              "type": "string"
            },
            "completion": {
              "nullable": true,
              "description": "Type of completion tracking: 0 = none, 1 = manual, 2 = automatic",
              "type": "integer",
              "javaEnums": [
                {
                  "name": "NONE"
                },
                {
                  "name": "MANUAL"
                },
                {
                  "name": "AUTOMATIC"
                }
              ],
              "enum": [
                0,
                1,
                2
              ]
            },
            "visible": {
              "nullable": true,
              "description": "Is the module visible",
              "type": "boolean"
            },
            "onclick": {
              "nullable": true,
              "description": "Onclick action",
              "type": "string"
            },
            "modname": {
              "description": "Activity module type",
              "type": "string"
            },
            "visibleoncoursepage": {
              "nullable": true,
              "description": "Is the module visible on the course page",
              "type": "boolean"
            },
            "activitybadge": {
              "type": "array",
              "items": {
                "nullable": true,
                "description": "Activity badge to display near the name",
                "type": "object",
                "title": "ActivityBadge",
                "properties": {
                  "badgeelementid": {
                    "nullable": true,
                    "description": "Optional ID for module to add code for badge",
                    "type": "string"
                  },
                  "badgeurl": {
                    "nullable": true,
                    "format": "uri",
                    "description": "Optional URL to redirect the user when badge is clicked",
                    "type": "string"
                  },
                  "badgecontent": {
                    "nullable": true,
                    "description": "The content to be displayed in the activity badge",
                    "type": "string"
                  },
                  "badgestyle": {
                    "nullable": true,
                    "description": "The style for the activity badge",
                    "type": "string"
                  },
                  "badgeextraattributes": {
                    "nullable": true,
                    "description": "Optional array of extra HTML attributes to add to badge element",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "title": "BadgeAttribute",
                      "properties": {
                        "name": {
                          "nullable": true,
                          "description": "Attribute name",
                          "type": "string"
                        },
                        "value": {
                          "nullable": true,
                          "description": "Attribute value",
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "noviewlink": {
              "nullable": true,
              "description": "Whether the module has no view page",
              "type": "boolean"
            },
            "url": {
              "nullable": true,
              "format": "uri",
              "description": "Activity URL",
              "type": "string"
            },
            "name": {
              "description": "Activity module name",
              "type": "string"
            },
            "availabilityinfo": {
              "nullable": true,
              "description": "Availability information for the module",
              "type": "string"
            },
            "modplural": {
              "description": "Activity module plural name",
              "type": "string"
            },
            "downloadcontent": {
              "nullable": true,
              "description": "Whether the module content can be downloaded",
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
