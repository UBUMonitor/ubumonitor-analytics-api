{
  "request": {
    "method": "GET",
    "path": "/api/public/sites/info?host=${MOODLE_HOST}"
  },
  "moodleMocks": [
    {
      "request": {
        "method": "POST",
        "path": "/lib/ajax/service.php",
        "body": [
          {
            "methodname": "tool_mobile_get_public_config",
            "args": {}
          }
        ]
      },
      "response": {
        "body": [
          {
            "error": false,
            "data": {
              "wwwroot": "https://school.moodledemo.net",
              "httpswwwroot": "https://school.moodledemo.net",
              "sitename": "Mount Orange",
              "enablewebservices": 1,
              "enablemobilewebservice": 1,
