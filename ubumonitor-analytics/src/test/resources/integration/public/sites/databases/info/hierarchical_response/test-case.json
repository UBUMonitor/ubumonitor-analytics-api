    "https~school.moodledemo.net~teacher.db",
    "https~school.moodledemo.net~student.db",
    "http~school.moodledemo.net~student.db"
  ],
  "expectedResponse": {
    "status": 200,
    "body": {
      "databases": [
        {
          "moodleUrl": "https://school.moodledemo.net",
          "users": [
            {
              "id": "https~school.moodledemo.net~student",
              "userName": "student",
              "location": "${DATABASE_FILE:https~school.moodledemo.net~student.db}"
            },
            {
              "id": "https~school.moodledemo.net~teacher",
              "userName": "teacher",
              "location": "${DATABASE_FILE:https~school.moodledemo.net~teacher.db}"
            }
          ]
        },
        {
          "moodleUrl": "http://school.moodledemo.net",
          "users": [
            {
              "id": "http~school.moodledemo.net~student",
              "userName": "student",
              "location": "${DATABASE_FILE:http~school.moodledemo.net~student.db}"
            }
          ]
        }
      ]
    }
  }
}
